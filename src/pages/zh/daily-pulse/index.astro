---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = await getCollection('zh', ({ data }) => data.tier === 'daily-pulse');
posts.sort((a, b) => +b.data.date - +a.data.date);
---

<BaseLayout title="每日脉搏" locale="zh">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-white mb-2">🚀 每日脉搏</h1>
    <p class="text-zinc-400 mb-8">每天 5-8 条产业快讯。5 分钟掌握中国硬件动态。</p>
    {posts.length === 0 ? <p class="text-zinc-500 py-12">首期即将上线。</p> : (
      <div class="space-y-4">
        {posts.map(p => (
          <a href={`/zh/daily-pulse/${p.slug}`} class="block p-5 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-cyan-700 transition-all">
            <h3 class="font-semibold text-white">{p.data.title}</h3>
            <p class="text-sm text-zinc-400 mt-1">{p.data.excerpt}</p>
            <time class="text-xs text-zinc-600 mt-2 block">{new Date(p.data.date).toLocaleDateString('zh-CN')}</time>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
