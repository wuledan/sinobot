---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="About SinoBot" locale="en">
  <div class="max-w-3xl mx-auto px-4 py-16">
    <h1 class="text-4xl font-bold text-white mb-6">About SinoBot</h1>
    <div class="prose prose-invert max-w-none">
      <p class="text-lg text-zinc-400 leading-relaxed">
        SinoBot is the bridge between China's explosive hardware ecosystem and the global audience.
        We track, decode, and analyze the companies, products, and trends shaping the future of robotics and smart hardware.
      </p>
      <h2 class="text-2xl font-bold text-white mt-10 mb-4">What We Cover</h2>
      <ul class="space-y-3 text-zinc-400">
        <li>🚀 <strong class="text-white">Daily Pulse</strong> — 5-8 industry briefs + video breakdowns every day</li>
        <li>🔧 <strong class="text-white">Hands-On Lab</strong> — Teardowns, DIY builds, open-source projects</li>
        <li>📊 <strong class="text-white">Deep Signal</strong> — Industry reports, technical deep-dives, founder interviews</li>
      </ul>
      <h2 class="text-2xl font-bold text-white mt-10 mb-4">Our Sources</h2>
      <p class="text-zinc-400">
        We aggregate and analyze information from Bilibili, Douyin, Zhihu, Weibo, Xiaohongshu,
        company announcements, 36Kr, and academic papers — translating and contextualizing
        for a global audience.
      </p>
      <p class="text-zinc-400 mt-6">
        SinoBot is an independent publication. We are not affiliated with any of the companies we cover.
      </p>
    </div>
  </div>
</BaseLayout>
