---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const daily = await getCollection('en', ({ data }) => data.tier === 'daily-pulse');
const handsOn = await getCollection('en', ({ data }) => data.tier === 'hands-on');
const deepSignal = await getCollection('en', ({ data }) => data.tier === 'deep-signal');
const latest = [...daily, ...handsOn, ...deepSignal].sort((a, b) => +b.data.date - +a.data.date).slice(0, 6);
---

<BaseLayout title="Home" description="Decoding China's Hardware & Robotics — Daily pulse, hands-on labs, deep signals." locale="en">
  <section class="relative overflow-hidden border-b border-zinc-800">
    <div class="max-w-6xl mx-auto px-4 py-24 md:py-32">
      <div class="text-center max-w-3xl mx-auto">
        <h1 class="text-5xl md:text-7xl font-extrabold text-white leading-tight mb-6">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Decoding China's</span><br/>Hardware &amp; Robotics
        </h1>
        <p class="text-xl text-zinc-400 mb-10 max-w-2xl mx-auto leading-relaxed">
          Daily pulse, hands-on labs, and deep signals from the world's most active hardware ecosystem.
          For makers, engineers, and investors.
        </p>
        <div class="flex gap-4 justify-center">
          <a href="/en/daily-pulse/" class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-lg text-white font-medium transition-colors">🚀 Daily Pulse</a>
          <a href="/en/hands-on/" class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-lg text-white font-medium transition-colors">🔧 Hands-On Lab</a>
          <a href="/en/deep-signal/" class="px-6 py-3 bg-zinc-800 hover:bg-zinc-700 border border-zinc-700 rounded-lg text-white font-medium transition-colors">📊 Deep Signal</a>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 py-16">
    <div class="grid gap-8 md:grid-cols-3 mb-16">
      <a href="/en/daily-pulse/" class="group p-6 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-cyan-700 transition-all hover:translate-y-[-2px]">
        <div class="text-3xl mb-3">🚀</div>
        <h3 class="text-lg font-bold text-white group-hover:text-cyan-400 transition-colors">Daily Pulse</h3>
        <p class="text-sm text-zinc-400 mt-2">5-8 industry briefs + 1 video breakdown every day. Stay on top of China's hardware news in 5 minutes.</p>
      </a>
      <a href="/en/hands-on/" class="group p-6 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-amber-700 transition-all hover:translate-y-[-2px]">
        <div class="text-3xl mb-3">🔧</div>
        <h3 class="text-lg font-bold text-white group-hover:text-amber-400 transition-colors">Hands-On Lab</h3>
        <p class="text-sm text-zinc-400 mt-2">Teardowns, DIY tutorials, open-source builds. For creators and makers who get their hands dirty.</p>
      </a>
      <a href="/en/deep-signal/" class="group p-6 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-purple-700 transition-all hover:translate-y-[-2px]">
        <div class="text-3xl mb-3">📊</div>
        <h3 class="text-lg font-bold text-white group-hover:text-purple-400 transition-colors">Deep Signal</h3>
        <p class="text-sm text-zinc-400 mt-2">Industry analysis, technical deep-dives, founder interviews. For engineers and investors who need depth.</p>
      </a>
    </div>

    <h2 class="text-2xl font-bold text-white mb-8 text-center">Latest</h2>
    {latest.length === 0 ? (
      <p class="text-zinc-500 text-center py-12">Content pipeline spinning up. First articles landing soon.</p>
    ) : (
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {latest.map(article => (
          <a href={`/en/${article.data.tier}/${article.slug}`} class="group block p-5 bg-zinc-900 rounded-xl border border-zinc-800 hover:border-zinc-700 transition-all hover:translate-y-[-2px]">
            <div class="flex items-center gap-2 mb-2">
              <span class={`text-xs font-medium uppercase px-2 py-0.5 rounded ${
                article.data.tier === 'daily-pulse' ? 'bg-cyan-900/50 text-cyan-400' :
                article.data.tier === 'hands-on' ? 'bg-amber-900/50 text-amber-400' :
                'bg-purple-900/50 text-purple-400'
              }`}>{article.data.tier}</span>
            </div>
            <h3 class="text-lg font-semibold text-white group-hover:text-zinc-200 transition-colors mb-2 leading-snug">{article.data.title}</h3>
            <p class="text-sm text-zinc-400 line-clamp-2">{article.data.excerpt || ''}</p>
            <time class="text-xs text-zinc-600 mt-3 block">{new Date(article.data.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
